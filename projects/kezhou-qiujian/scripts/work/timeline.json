 "lines": [
  {
   "scene": "s1",
   "start": 7.1,
   "dur": 4.27,
   "text": "楚國有一個人，帶著一把寶劍，搭船渡江。"
  },
  {
   "scene": "s1",
   "start": 11.919999999999998,
   "dur": 4.85,
   "text": "船到江心，忽然一陣搖晃，劍滑出船舷，掉進水裡。"
  },
  {
   "scene": "s2",
   "start": 18.769999999999996,
   "dur": 6.91,
   "text": "同船的人都替他著急，他卻不慌不忙，拿出小刀，在船舷上刻了一道記號。"
  },
  {
   "scene": "s2",
   "start": 26.229999999999997,
   "dur": 3.88,
   "text": "「別急，」他說，「我的劍，就是從這裡掉下去的。」"
  },
  {
   "scene": "s3",
   "start": 32.10999999999999,
   "dur": 3.96,
   "text": "船靠了岸，他才從刻記號的地方，跳下水去找。"
  },
  {
   "scene": "s3",
   "start": 36.61999999999999,
   "dur": 5.86,
   "text": "可是船已經走了很遠，水也一直在流，劍怎麼還會留在原地呢？"
  },
  {
   "scene": "s3",
   "start": 43.02999999999999,
   "dur": 2.76,
   "text": "用舊的記號，去找新的位置。"
  },
  {
   "scene": "s3",
   "start": 46.33999999999999,
   "dur": 2.29,
   "text": "這就叫做「刻舟求劍」。"
  }
 ],
